log_dir                : tmaze_%Y%m%d_%H%M%S
environment:
	reward_probs       : [1, 0]
pool:
	sequence_length    :      3
	rollouts           :   5000
	random             :  False
	simple             :  False
optimizer:
	lr                 :  0.001
trainer:
	batch_size         :     10
	epochs             :     50
	save_epoch         :      5
model:
	init_mode          : positive
	max_bond           :     24
	cutoff             :   0.03
	dtype              : torch.complex128
device                 :   cuda
